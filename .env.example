# Copy to .env and fill in the two REQUIRED values. Everything else has a working default.

# --- REQUIRED --------------------------------------------------------------------------------------------------
# Access code for the upload page (16+ characters). Make one with:  openssl rand -hex 24
SHORTS_TOKEN=
# GPU access: the host's "render" group id. Find it with:  getent group render | cut -d: -f3
RENDER_GID=
# The host's "video" group id (44 on Debian/Ubuntu). Check with:  getent group video | cut -d: -f3
VIDEO_GID=44

# --- Where things live -----------------------------------------------------------------------------------------
# Uploads, finished shorts, cached AI models, ComfyUI models/workflows. Needs plenty of space (phone video is big).
DATA_PATH=./data
# Page + API port. 127.0.0.1 = only this machine / a Cloudflare Tunnel. 0.0.0.0 = also your home network (faster
# uploads from your phone on Wi-Fi; the access code still protects it).
BIND_ADDR=127.0.0.1
PORT=8590

# --- Ollama / Open WebUI (your existing ones) -------------------------------------------------------------------
# Ollama's API as seen from inside a container. host.docker.internal = the Docker host.
OLLAMA_URL=http://host.docker.internal:11434
# Optional: go through Open WebUI instead (uses its /ollama proxy). Create a key in Open WebUI: Settings > Account > API Keys.
OPENWEBUI_URL=
OPENWEBUI_API_KEY=
# Models (pull them once: ollama pull qwen2.5:7b && ollama pull qwen2.5vl:7b). Both fit the RX 6800's 16 GB,
# and are unloaded before the video generator runs.
TEXT_MODEL=qwen2.5:7b
VISION_MODEL=qwen2.5vl:7b
OLLAMA_NUM_CTX=16384
VISION_MAX_FRAMES=16
OLLAMA_UNLOAD_AFTER=true

# --- Speech (Whisper, on the GPU through ROCm PyTorch) ----------------------------------------------------------
WHISPER_ENGINE=torch
WHISPER_MODEL=turbo
WHISPER_DEVICE=gpu
# Blank = detect the language automatically, or set e.g. en
WHISPER_LANGUAGE=

# --- Video generator for End-Frame Motion transitions (ComfyUI, on the GPU) --------------------------------------
# The bundled comfyui service. Point this at another ComfyUI if you already run one; blank disables it.
COMFYUI_URL=http://comfyui:8188
# Your image-to-video workflow exported from ComfyUI with Workflow > Export (API). Path inside the container.
COMFY_WORKFLOW=/data/comfy/i2v_api.json
# Generated clip size (9:16). Must suit your model; multiples of 32 are safe.
COMFY_WIDTH=480
COMFY_HEIGHT=832
COMFY_SET_SIZE=true
COMFY_MAX_CLIPS=3
COMFY_TIMEOUT=1200
# Optional words added to every camera prompt, e.g.: shot on 35mm film, natural light
COMFY_PROMPT_SUFFIX=

# --- Sound and video -------------------------------------------------------------------------------------------
# demucs = AI dialogue isolation on the GPU (falls back to rnnoise if it fails) | rnnoise | basic | off
AUDIO_CLEANUP=demucs
# vaapi = hardware decode/encode on the Radeon (falls back to software automatically if the self-test fails) | none
HWACCEL=vaapi
VAAPI_DEVICE=/dev/dri/renderD128
# HDR (iPhone Dolby Vision / HLG) to SDR tone-mapping curve: hable | mobius | reinhard
HDR_TONEMAP=hable

# --- Housekeeping ----------------------------------------------------------------------------------------------
# Delete uploads and shorts older than this many days (0 = keep forever)
RETENTION_DAYS=14
MAX_UPLOAD_GB=10
CHUNK_MB=16
# auto = Secure cookie when the request came over HTTPS (e.g. through Cloudflare)
COOKIE_SECURE=auto

# --- Build (only change if you know you need to) ---------------------------------------------------------------
# PyTorch ROCm wheels for AMD GPUs. See https://pytorch.org/get-started/locally/ for newer ROCm versions.
TORCH_INDEX=https://download.pytorch.org/whl/rocm6.4
TORCH_VERSION=2.8.0
INSTALL_DEMUCS=true
INSTALL_COMFYUI=true
# RX 6800 = gfx1030 = 10.3.0 (also lets other RDNA2 cards such as the 6700 XT use the gfx1030 kernels)
HSA_OVERRIDE_GFX_VERSION=10.3.0
